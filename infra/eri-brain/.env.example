# eri-brain vLLM serving config. Copy to .env and edit. See README.md + ADR-0004.

# Model to serve (HF id or local path). Model-agnostic — the CLI never hardcodes this.
# Leading pick: dense Qwen3-32B (Apache-2.0). Bake off before fine-tuning spend.
ERI_BRAIN_MODEL=Qwen/Qwen3-32B

# Bearer key the server requires and the CLI sends as ERI_BRAIN_KEY. Generate a strong
# random value; never commit the real .env.
ERI_BRAIN_KEY=change-me

# Optional quantization for higher tok/s + lower VRAM: awq | gptq | fp8 | (empty = none).
ERI_BRAIN_QUANT=

# Max context length. Raise if your tasks need it (costs VRAM).
ERI_BRAIN_MAX_LEN=32768

# Host/port the OpenAI-compatible server binds.
ERI_BRAIN_HOST=0.0.0.0
ERI_BRAIN_PORT=8000

# GPU memory fraction vLLM may use (0-1).
ERI_BRAIN_GPU_UTIL=0.92
