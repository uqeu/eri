#!/usr/bin/env zsh
set -euo pipefail

ROOT_DIR="${0:A:h}/.."
PYTHON="$ROOT_DIR/.venv-lite/bin/python"
SIDECAR="$ROOT_DIR/script/eri_vision_sidecar.py"

if [[ ! -x "$PYTHON" ]]; then
  printf '%s\n' '{"type":"error","message":"lite venv missing. Run: script/eri_lite_setup"}' >&2
  exit 127
fi

if [[ ! -f "$SIDECAR" ]]; then
  printf '%s\n' '{"type":"error","message":"vision sidecar python module missing"}' >&2
  exit 127
fi

exec "$PYTHON" "$SIDECAR" "$@"
