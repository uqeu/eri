#!/usr/bin/env zsh
# Bootstrap the EyeGestures gaze sidecar venv for eri.
set -euo pipefail

ROOT_DIR="${0:A:h}/.."
VENV_DIR="$ROOT_DIR/.venv-eyegestures"
UV_CACHE="$ROOT_DIR/.uv-cache"

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required (https://docs.astral.sh/uv). Install with: brew install uv"
  exit 1
fi

mkdir -p "$UV_CACHE"

if [[ ! -d "$VENV_DIR" ]]; then
  echo "Creating EyeGestures venv at $VENV_DIR"
  uv --cache-dir "$UV_CACHE" venv --python 3.11 "$VENV_DIR"
fi

echo "Installing EyeGestures and supporting libraries"
uv --cache-dir "$UV_CACHE" pip install \
  --python "$VENV_DIR/bin/python" \
  --upgrade \
  eyeGestures \
  opencv-python \
  mediapipe \
  numpy \
  scikit-learn

echo "EyeGestures environment ready."
echo "Run: script/eri_gaze_sidecar --run"
