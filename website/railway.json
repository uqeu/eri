{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker"
  },
  "deploy": {
    "startCommand": "bun run scripts/spectrum-worker.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 100,
    "numReplicas": 1
  }
}
