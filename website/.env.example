# Supabase / Postgres. Backend writes use DATABASE_URL via the `postgres`
# driver; the @supabase/supabase-js helpers are reserved for any future
# storage / auth-on-Supabase work.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service role key — backend only. NEVER prefix with NEXT_PUBLIC_, never
# expose to the browser. Required for API routes that write to the DB.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Direct Postgres connection string for the `postgres` driver. Find it in
# Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=postgres://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Auth — HS256 JWT signing key. Use `openssl rand -hex 64` to generate,
# or reuse Supabase's JWT secret: `JWT_SECRET=$SUPABASE_JWT_SECRET`
# (Supabase → Project Settings → API → JWT Secret).
JWT_SECRET=

# K_server — at-rest key for the Tier-A personalization profile (phone eri).
# Base64 of 32 random bytes: `openssl rand -base64 32`. The profile is
# server-readable but encrypted at rest, so a leaked DB dump alone is useless.
ERI_SERVER_ENCRYPTION_KEY=

# Stripe API. Get from https://dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=

# Stripe webhook secret. From `stripe listen` output, or the dashboard webhook config.
STRIPE_WEBHOOK_SECRET=

# Resend (optional). If unset, password-reset just logs and returns 204.
# https://resend.com/api-keys
RESEND_API_KEY=

# Stripe price IDs (price_..., not product IDs). Monthly + yearly for each tier.
# If unset, lib/stripe.ts falls back to the test-mode IDs from the eri labs
# sandbox account so the checkout flow works in dev without further setup.
# For PRODUCTION, override these with live-mode price IDs from the live Stripe
# dashboard — the eri labs account is sandbox-only.
#
# Current test-mode (sandbox) values, for reference:
#   ERI_PRICE_STARTER=price_1TZEdZ4evv030ZvBoREq7XUd   # $15/mo
#   ERI_PRICE_STARTER_YEARLY=price_1TZEde4evv030ZvBIwXkK6W4  # $144/yr
#   ERI_PRICE_PRO=price_1TZEiR4evv030ZvBALDZ0WI1       # $25/mo
#   ERI_PRICE_PRO_YEARLY=price_1TZEdo4evv030ZvBbgW93xHr      # $240/yr
#   ERI_PRICE_PRO_PLUS=price_1TZEds4evv030ZvBLyuqklxG  # $45/mo
#   ERI_PRICE_PRO_PLUS_YEARLY=price_1TZEdx4evv030ZvBqpxdekKS # $432/yr
#   ERI_PRICE_TEAMS=price_1TZEe14evv030ZvBTIzgg3bX     # $30/mo per seat
#   ERI_PRICE_TEAMS_YEARLY=price_1TZEe54evv030ZvB8Si8Po2S    # $288/yr per seat
ERI_PRICE_STARTER=
ERI_PRICE_STARTER_YEARLY=
ERI_PRICE_PRO=
ERI_PRICE_PRO_YEARLY=
ERI_PRICE_PRO_PLUS=
ERI_PRICE_PRO_PLUS_YEARLY=
ERI_PRICE_TEAMS=
ERI_PRICE_TEAMS_YEARLY=

# Base URL used for Stripe success/cancel URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth. Create credentials in Google Cloud Console → APIs & Services
# → OAuth client (Web). Authorized redirect URI:
# https://eri.dev/api/auth/google/callback
# (and http://localhost:3000/api/auth/google/callback for dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Composio connector layer (phone-eri). Composio holds the OAuth tokens; eri only
# records which toolkits a user connected. Per-toolkit auth configs are named
# COMPOSIO_AUTH_CONFIG_<TOOLKIT> (uppercased), e.g. COMPOSIO_AUTH_CONFIG_GMAIL.
COMPOSIO_API_KEY=
COMPOSIO_MCP_SERVER_ID=
# COMPOSIO_AUTH_CONFIG_GMAIL=
# COMPOSIO_AUTH_CONFIG_GITHUB=
