+ *--------------------------------------------------------------------------------------------*/
+
+import * as dom from '../../../../base/browser/dom.js';
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { KeyCode } from '../../../../base/common/keyCodes.js';
+import { localize } from '../../../../nls.js';
+import { ICodeEditor } from '../../../browser/editorBrowser.js';
+import { ZoneWidget } from '../../zoneWidget/browser/zoneWidget.js';
+import './media/eriInlineEdit.css';
+
+export interface IEriInlineEditWidgetCallbacks {
+	onAccept: (prompt: string) => void;
+	onCancel: () => void;
+}
+
+const ROOT_CLASS = 'eri-inline-edit-widget';
+const MIN_WIDTH = 560;
+
+/**
+ * Cursor-style Cmd-K inline edit overlay. A ZoneWidget inserted at the cursor row.
+ * This patch supplies the chrome only — the bundled `eri-ai-panel` extension
+ * overrides `eri.inlineEdit` with the real model invocation.
+ */
+export class EriInlineEditWidget extends ZoneWidget {
+
+	private readonly _onDidClose = new Emitter<void>();
+	readonly onDidClose: Event<void> = this._onDidClose.event;
+
+	private readonly _callbacks: IEriInlineEditWidgetCallbacks;
+
+	private _input: HTMLInputElement | undefined;
+	private _modelPill: HTMLElement | undefined;
+
+	constructor(editor: ICodeEditor, callbacks: IEriInlineEditWidgetCallbacks) {
+		super(editor, {
+			showArrow: false,
+			showFrame: false,
+			isAccessible: true,
+			keepEditorSelection: true,
+			className: ROOT_CLASS,
+			ordinal: 10000,
+		});
+		this._callbacks = callbacks;
+		this._disposables.add(this._onDidClose);
+	}
+
+	protected _fillContainer(container: HTMLElement): void {
+		container.classList.add(`${ROOT_CLASS}-container`);
+		container.style.minWidth = `${MIN_WIDTH}px`;
+
+		const shell = dom.append(container, dom.$(`.${ROOT_CLASS}-shell`));
+
+		const row = dom.append(shell, dom.$(`.${ROOT_CLASS}-row`));
+
+		const input = document.createElement('input');
+		input.type = 'text';
+		input.spellcheck = false;
+		input.className = `${ROOT_CLASS}-input`;
+		input.placeholder = localize('eriInlineEdit.placeholder', "Edit selection — describe the change…");
+		input.setAttribute('aria-label', localize('eriInlineEdit.ariaLabel', "Inline edit prompt"));
+		row.appendChild(input);
+		this._input = input;
+
+		const pill = document.createElement('div');
+		pill.className = `${ROOT_CLASS}-model-pill`;
+		pill.textContent = 'mercury-coder';
+		pill.title = localize('eriInlineEdit.modelTitle', "Active model");
+		row.appendChild(pill);
+		this._modelPill = pill;
+
+		const footer = dom.append(shell, dom.$(`.${ROOT_CLASS}-footer`));
+
+		const hintEnter = dom.append(footer, dom.$(`span.${ROOT_CLASS}-hint`));
+		const enterKey = dom.append(hintEnter, dom.$(`kbd.${ROOT_CLASS}-kbd`));
+		enterKey.textContent = '⏎';
+		const enterLabel = dom.append(hintEnter, dom.$('span'));
+		enterLabel.textContent = ' ' + localize('eriInlineEdit.submit', "submit");
+
+		const hintEsc = dom.append(footer, dom.$(`span.${ROOT_CLASS}-hint`));
+		const escKey = dom.append(hintEsc, dom.$(`kbd.${ROOT_CLASS}-kbd`));
+		escKey.textContent = 'esc';
+		const escLabel = dom.append(hintEsc, dom.$('span'));
+		escLabel.textContent = ' ' + localize('eriInlineEdit.dismiss', "dismiss");
+
+		this._disposables.add(dom.addStandardDisposableListener(input, 'keydown', (e) => {
+			if (e.equals(KeyCode.Enter)) {
+				e.preventDefault();
+				e.stopPropagation();
+				const value = input.value.trim();
+				if (value.length === 0) {
+					return;
+				}
+				this._callbacks.onAccept(value);
+			} else if (e.equals(KeyCode.Escape)) {
+				e.preventDefault();
+				e.stopPropagation();
+				this._callbacks.onCancel();
+				this._onDidClose.fire();
+			}
+		}));
+
+		this._disposables.add(dom.addDisposableListener(container, 'mousedown', (e) => {
+			// Prevent the click from blurring out of the widget.
+			e.stopPropagation();
+		}));
+	}
+
+	focus(): void {
+		this._input?.focus();
+	}
+
+	setModelLabel(label: string): void {
+		if (this._modelPill) {
+			this._modelPill.textContent = label;
+		}
+	}
+
+	override dispose(): void {
+		this._onDidClose.fire();
+		super.dispose();
+	}
+}
