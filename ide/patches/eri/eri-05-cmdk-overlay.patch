+
+import { KeyCode, KeyMod } from '../../../../base/common/keyCodes.js';
+import { DisposableStore, IDisposable } from '../../../../base/common/lifecycle.js';
+import { localize, localize2 } from '../../../../nls.js';
+import { ContextKeyExpr, IContextKey, IContextKeyService, RawContextKey } from '../../../../platform/contextkey/common/contextkey.js';
+import { KeybindingWeight } from '../../../../platform/keybinding/common/keybindingsRegistry.js';
+import { ICodeEditor } from '../../../browser/editorBrowser.js';
+import {
+	EditorAction,
+	EditorContributionInstantiation,
+	ServicesAccessor,
+	registerEditorAction,
+	registerEditorContribution,
+} from '../../../browser/editorExtensions.js';
+import { IEditorContribution } from '../../../common/editorCommon.js';
+import { EditorContextKeys } from '../../../common/editorContextKeys.js';
+import { EriInlineEditWidget } from './eriInlineEditWidget.js';
+
+export const EriInlineEditVisible = new RawContextKey<boolean>('eriInlineEditVisible', false, localize('eriInlineEditVisible', "Whether the eri inline edit widget is visible"));
+
+export class EriInlineEditController implements IEditorContribution {
+
+	public static readonly ID = 'editor.contrib.eriInlineEdit';
+
+	static get(editor: ICodeEditor): EriInlineEditController | null {
+		return editor.getContribution<EriInlineEditController>(EriInlineEditController.ID);
+	}
+
+	private readonly _disposables = new DisposableStore();
+	private readonly _visibleContextKey: IContextKey<boolean>;
+	private _widget: EriInlineEditWidget | undefined;
+	private _widgetListener: IDisposable | undefined;
+
+	constructor(
+		private readonly _editor: ICodeEditor,
+		@IContextKeyService contextKeyService: IContextKeyService,
+	) {
+		this._visibleContextKey = EriInlineEditVisible.bindTo(contextKeyService);
+		this._disposables.add(this._editor.onDidChangeModel(() => this.hide()));
+	}
+
+	dispose(): void {
+		this.hide();
+		this._disposables.dispose();
+	}
+
+	show(): void {
+		if (!this._editor.hasModel()) {
+			return;
+		}
+		const position = this._editor.getPosition();
+		if (!position) {
+			return;
+		}
+
+		if (this._widget) {
+			this._widget.dispose();
+			this._widget = undefined;
+		}
+
+		const widget = new EriInlineEditWidget(this._editor, {
+			onAccept: (prompt) => {
+				// Stub: the bundled eri-ai-panel extension overrides this via the
+				// `eri.inlineEdit` command. Log so the chrome is verifiable standalone.
+				console.log('[eri] inline edit prompt:', prompt);
+				this.hide();
+			},
+			onCancel: () => this.hide(),
+		});
+		widget.create();
+		widget.show(position, 3);
+		widget.focus();
+
+		this._widget = widget;
+		this._widgetListener = widget.onDidClose(() => this.hide());
+		this._visibleContextKey.set(true);
+	}
+
+	hide(): void {
+		this._widgetListener?.dispose();
+		this._widgetListener = undefined;
+		if (this._widget) {
+			this._widget.dispose();
+			this._widget = undefined;
+		}
+		this._visibleContextKey.reset();
+		this._editor.focus();
+	}
+}
+
+class EriInlineEditAction extends EditorAction {
+	constructor() {
+		super({
+			id: 'eri.inlineEdit',
+			label: localize2('eri.inlineEdit', "eri: Inline Edit"),
+			alias: 'eri: Inline Edit',
+			precondition: EditorContextKeys.writable,
+			kbOpts: {
+				kbExpr: EditorContextKeys.editorTextFocus,
+				primary: KeyMod.CtrlCmd | KeyCode.KeyK,
+				weight: KeybindingWeight.EditorContrib,
+			},
+		});
+	}
+
+	override run(_accessor: ServicesAccessor, editor: ICodeEditor): void {
+		EriInlineEditController.get(editor)?.show();
+	}
+}
+
+class EriInlineEditCancelAction extends EditorAction {
+	constructor() {
+		super({
+			id: 'eri.inlineEdit.cancel',
+			label: localize2('eri.inlineEdit.cancel', "eri: Cancel Inline Edit"),
+			alias: 'eri: Cancel Inline Edit',
+			precondition: ContextKeyExpr.and(EriInlineEditVisible),
+			kbOpts: {
+				kbExpr: ContextKeyExpr.and(EriInlineEditVisible),
+				primary: KeyCode.Escape,
+				weight: KeybindingWeight.EditorContrib + 10,
+			},
+		});
+	}
+
+	override run(_accessor: ServicesAccessor, editor: ICodeEditor): void {
+		EriInlineEditController.get(editor)?.hide();
+	}
+}
+
+registerEditorContribution(EriInlineEditController.ID, EriInlineEditController, EditorContributionInstantiation.Lazy);
+registerEditorAction(EriInlineEditAction);
+registerEditorAction(EriInlineEditCancelAction);
