+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) eri. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/* eri status bar mic indicator.
+ *
+ * The status bar entry is registered with id `eri.mic`. Each status bar
+ * item gets a DOM element whose `id` matches the entry id; we escape the
+ * dot in CSS selectors as `\.` so `#eri\.mic` resolves cleanly.
+ *
+ * State is mirrored onto `document.body`:
+ *   .eri-mic-idle        -> dim glyph
+ *   .eri-mic-listening   -> accent glyph + animated 4-bar waveform
+ *   .eri-diffusion-fire  -> pulsing blue dot overlay
+ */
+
+.monaco-workbench .part.statusbar .statusbar-item#eri\.mic {
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	padding: 0 8px;
+	position: relative;
+}
+
+.monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a {
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	color: var(--vscode-statusBar-foreground);
+	opacity: 0.6;
+	transition: opacity 120ms ease, color 120ms ease;
+}
+
+/* Listening: accent + animated waveform bars after the glyph. */
+body.eri-mic-listening .monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a {
+	color: #e0ff4f;
+	opacity: 1;
+}
+
+.monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a::after {
+	content: '';
+	display: inline-block;
+	width: 22px;
+	height: 10px;
+	margin-left: 2px;
+	background-image:
+		linear-gradient(currentColor, currentColor),
+		linear-gradient(currentColor, currentColor),
+		linear-gradient(currentColor, currentColor),
+		linear-gradient(currentColor, currentColor);
+	background-repeat: no-repeat;
+	background-position: 0 50%, 6px 50%, 12px 50%, 18px 50%;
+	background-size: 3px 30%, 3px 30%, 3px 30%, 3px 30%;
+	opacity: 0; /* hidden in idle */
+	transition: opacity 120ms ease;
+}
+
+body.eri-mic-listening .monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a::after {
+	opacity: 1;
+	animation: eri-mic-waveform 0.3s ease-in-out infinite alternate;
+}
+
+/* 4-bar waveform: each "bar" is one of the four background gradients above.
+ * We can't animate background-size per layer with stagger in pure CSS without
+ * SVG, so we modulate the whole element's background-size and offset the
+ * apparent stagger by varying the size of each band via a step keyframe
+ * applied to nested pseudo-elements. */
+@keyframes eri-mic-waveform {
+	0%   { background-size: 3px 20%, 3px 70%, 3px 35%, 3px 90%; }
+	25%  { background-size: 3px 55%, 3px 30%, 3px 80%, 3px 45%; }
+	50%  { background-size: 3px 85%, 3px 60%, 3px 25%, 3px 70%; }
+	75%  { background-size: 3px 40%, 3px 90%, 3px 55%, 3px 30%; }
+	100% { background-size: 3px 70%, 3px 25%, 3px 90%, 3px 55%; }
+}
+
+/* Diffusion-fire: a small pulsing blue dot rendered as a ::before. Overrides
+ * the listening color if both are active (diffusion takes visual priority). */
+.monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a::before {
+	content: '';
+	display: inline-block;
+	width: 6px;
+	height: 6px;
+	border-radius: 50%;
+	background: #228df2;
+	opacity: 0;
+	transform: scale(0.8);
+	transition: opacity 120ms ease;
+}
+
+body.eri-diffusion-fire .monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a::before {
+	opacity: 1;
+	animation: eri-diffusion-pulse 1.2s ease-in-out infinite;
+}
+
+body.eri-diffusion-fire .monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a {
+	color: #228df2;
+	opacity: 1;
+}
+
+@keyframes eri-diffusion-pulse {
+	0%, 100% { transform: scale(0.8); opacity: 0.55; box-shadow: 0 0 0 0 rgba(34, 141, 242, 0.45); }
+	50%      { transform: scale(1.15); opacity: 1;    box-shadow: 0 0 0 4px rgba(34, 141, 242, 0); }
+}
+
+/* Respect users who ask for reduced motion. */
+@media (prefers-reduced-motion: reduce) {
+	.monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a::after,
+	.monaco-workbench .part.statusbar .statusbar-item#eri\.mic > a::before {
+		animation: none !important;
+	}
+}
+
+/* Hover affordance — slight lift, no background flip (theme is already flat). */
+.monaco-workbench .part.statusbar .statusbar-item#eri\.mic:hover > a {
+	opacity: 1;
+}
