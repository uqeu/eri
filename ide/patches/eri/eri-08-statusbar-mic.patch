+import './media/eriStatusBar.css';
+import { Disposable, DisposableStore } from '../../../../base/common/lifecycle.js';
+import { localize } from '../../../../nls.js';
+import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { IWorkbenchContribution, WorkbenchPhase, registerWorkbenchContribution2 } from '../../../common/contributions.js';
+import { IStatusbarEntry, IStatusbarEntryAccessor, IStatusbarService, StatusbarAlignment } from '../../../services/statusbar/browser/statusbar.js';
+
+const ERI_MIC_ENTRY_ID = 'eri.mic';
+const ERI_TOGGLE_MIC_COMMAND = 'eri.toggleMic';
+const ERI_SET_DIFFUSION_COMMAND = 'eri.setDiffusionFire';
+
+type EriMicState = 'idle' | 'listening';
+
+/**
+ * Tracks mic + diffusion-fire state and mirrors it onto `document.body` as
+ * data-attributes so the CSS-only animations can light up. We use the body
+ * rather than the status bar entry container because IStatusbarEntry does
+ * not expose its DOM node, and querying by id would be brittle across
+ * auxiliary status bars.
+ */
+class EriStatusBarContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.eriStatusBar';
+
+	private readonly entryDisposables = this._register(new DisposableStore());
+	private accessor: IStatusbarEntryAccessor | undefined;
+
+	private micState: EriMicState = 'idle';
+	private diffusionFire = false;
+
+	constructor(
+		@IStatusbarService private readonly statusbarService: IStatusbarService,
+	) {
+		super();
+
+		this.registerCommands();
+		this.renderEntry();
+		this.applyBodyState();
+	}
+
+	private registerCommands(): void {
+		this._register(CommandsRegistry.registerCommand(ERI_TOGGLE_MIC_COMMAND, () => {
+			this.micState = this.micState === 'idle' ? 'listening' : 'idle';
+			this.applyBodyState();
+			this.renderEntry();
+		}));
+
+		this._register(CommandsRegistry.registerCommand(ERI_SET_DIFFUSION_COMMAND, (_accessor, on?: boolean) => {
+			this.diffusionFire = typeof on === 'boolean' ? on : !this.diffusionFire;
+			this.applyBodyState();
+			this.renderEntry();
+		}));
+	}
+
+	private renderEntry(): void {
+		const entry = this.buildEntry();
+
+		if (this.accessor) {
+			this.accessor.update(entry);
+			return;
+		}
+
+		// High priority -> leftmost on the LEFT-aligned cluster.
+		this.accessor = this.statusbarService.addEntry(
+			entry,
+			ERI_MIC_ENTRY_ID,
+			StatusbarAlignment.LEFT,
+			Number.MAX_SAFE_INTEGER,
+		);
+		this.entryDisposables.add(this.accessor);
+	}
+
+	private buildEntry(): IStatusbarEntry {
+		// We intentionally render a single static glyph here; the waveform
+		// bars + diffusion dot are CSS pseudo-elements attached to the
+		// entry container by id (`#eri\\.mic`). Their visibility is driven
+		// by data-attributes mirrored onto `document.body`.
+		const tooltip = this.diffusionFire
+			? localize('eri.mic.tooltip.diffusion', "eri is generating (diffusion fire)")
+			: this.micState === 'listening'
+				? localize('eri.mic.tooltip.listening', "eri is listening — click to mute")
+				: localize('eri.mic.tooltip.idle', "Talk to eri (click to start voice)");
+
+		return {
+			name: localize('eri.mic.name', "eri Mic"),
+			text: '🎤', // 🎤 — codicon syntax is avoided so we keep the literal mic for theming.
+			ariaLabel: tooltip,
+			tooltip,
+			command: ERI_TOGGLE_MIC_COMMAND,
+		};
+	}
+
+	private applyBodyState(): void {
+		const body = typeof document !== 'undefined' ? document.body : undefined;
+		if (!body) {
+			return;
+		}
+
+		body.classList.toggle('eri-mic-listening', this.micState === 'listening');
+		body.classList.toggle('eri-mic-idle', this.micState === 'idle');
+		body.classList.toggle('eri-diffusion-fire', this.diffusionFire);
+	}
+}
+
+registerWorkbenchContribution2(
+	EriStatusBarContribution.ID,
+	EriStatusBarContribution,
+	WorkbenchPhase.AfterRestored,
+);
+
+// Make sure the command is resolvable even before the contribution has run
+// (e.g. when a keybinding fires it during early startup). The contribution
+// will re-register the real handler once instantiated; CommandsRegistry
+// allows last-writer-wins for the same id.
+CommandsRegistry.registerCommand({
+	id: ERI_TOGGLE_MIC_COMMAND,
+	handler: () => { /* no-op until contribution instantiates */ },
+	metadata: {
+		description: localize('eri.toggleMic.desc', "Toggle eri voice listening"),
+		args: [],
+	},
+});
+
+// Re-export ids for use by other patches (chat panel, voice sidecar bridge).
+export const ERI_STATUSBAR_IDS = Object.freeze({
+	entry: ERI_MIC_ENTRY_ID,
+	toggleMic: ERI_TOGGLE_MIC_COMMAND,
+	setDiffusionFire: ERI_SET_DIFFUSION_COMMAND,
+});
+
+// Ensure the Registry import is retained even when tree-shaken builds drop
+// unused symbols (some bundlers strip side-effect-free imports otherwise).
+// eslint-disable-next-line @typescript-eslint/no-unused-vars
+const _keepRegistry = Registry;
