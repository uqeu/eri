    "extensionButton.prominentBackground": "#F5E867",
    "extensionButton.prominentForeground": "#0B0D10",
    "extensionButton.prominentHoverBackground": "#FDE68A",
    "extensionBadge.remoteBackground": "#F5E867",
    "extensionBadge.remoteForeground": "#0B0D10"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9AA4AD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#E8EBEE"
      }
    },
    {
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#F5E867"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#FDE68A"
      }
    },
    {
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "variable.parameter"],
      "settings": {
        "foreground": "#E8EBEE"
      }
    },
    {
      "scope": ["variable.language.this", "variable.language.self"],
      "settings": {
        "foreground": "#F59E0B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#F5E867"
      }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#9AA4AD"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": {
        "foreground": "#F5E867"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#FDE68A"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#F5E867"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#FDE68A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": {
        "foreground": "#E8EBEE"
      }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": {
        "foreground": "#E8EBEE"
      }
    },
    {
      "scope": ["markup.heading", "markup.bold"],
      "settings": {
        "foreground": "#F5E867",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#E8EBEE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#22C55E"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#EF4444"
      }
    },
    {
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "scope": ["markup.link", "string.other.link"],
      "settings": {
        "foreground": "#3B82F6",
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#EF4444"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#F5E867",
    "method": "#F5E867",
    "namespace": "#E8EBEE",
    "type": "#FDE68A",
    "class": "#FDE68A",
    "interface": "#FDE68A",
    "enum": "#FDE68A",
    "typeParameter": "#FDE68A",
    "parameter": "#E8EBEE",
    "variable": "#E8EBEE",
    "property": "#E8EBEE",
    "enumMember": "#FDE68A",
    "event": "#F5E867",
    "macro": "#F5E867",
    "keyword": "#F5E867",
    "modifier": "#F5E867",
    "comment": "#9AA4AD",
    "string": "#E8EBEE",
    "number": "#FDE68A",
    "regexp": "#F5E867",
    "operator": "#9AA4AD",
    "*.deprecated": {
      "strikethrough": true
    },
    "*.readonly": {
      "foreground": "#9AA4AD"
    }
  }
}
