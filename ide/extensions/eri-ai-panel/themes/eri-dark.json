    "progressBar.background": "#F5E867",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#3B465166",
    "scrollbarSlider.hoverBackground": "#3B465199",
    "scrollbarSlider.activeBackground": "#F5E86766",

    "notificationCenter.border": "#1D2329",
    "notificationCenterHeader.background": "#0F1216",
    "notificationCenterHeader.foreground": "#E8EBEE",
    "notifications.background": "#0F1216",
    "notifications.foreground": "#E8EBEE",
    "notifications.border": "#1D2329",
    "notificationsErrorIcon.foreground": "#EF4444",
    "notificationsWarningIcon.foreground": "#F59E0B",
    "notificationsInfoIcon.foreground": "#3B82F6",

    "quickInput.background": "#0F1216",
    "quickInput.foreground": "#E8EBEE",
    "quickInputTitle.background": "#0F1216",
    "pickerGroup.border": "#1D2329",
