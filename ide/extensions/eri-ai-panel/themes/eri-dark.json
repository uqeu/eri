    "input.placeholderForeground": "#9AA4AD",
    "inputOption.activeBackground": "#1D2329",
    "inputOption.activeForeground": "#F5E867",
    "inputOption.activeBorder": "#F5E867",
    "inputValidation.errorBackground": "#1D2329",
    "inputValidation.errorBorder": "#EF4444",
    "inputValidation.warningBackground": "#1D2329",
    "inputValidation.warningBorder": "#F59E0B",
    "inputValidation.infoBackground": "#1D2329",
    "inputValidation.infoBorder": "#3B82F6",

    "dropdown.background": "#0F1216",
    "dropdown.foreground": "#E8EBEE",
