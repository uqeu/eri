    "editorSuggestWidget.foreground": "#E8EBEE",
    "editorSuggestWidget.border": "#3B4651",
    "editorSuggestWidget.highlightForeground": "#F5E867",
    "editorSuggestWidget.selectedBackground": "#1D2329",
    "editorHoverWidget.background": "#0F1216",
    "editorHoverWidget.border": "#3B4651",

