    "onCommand:eri.terminals.spawnInGroup",
    "onCommand:eri.terminals.findCommand",
    "onCommand:eri.terminals.saveLayout",
    "onCommand:eri.terminals.restoreLayout",
    "onCommand:eri.terminals.openRecipe",
    "onCommand:eri.terminals.layoutQuad",
    "onCommand:eri.visualEditor.open",
    "onCommand:eri.visualEditor.setUrl",
    "onCommand:eri.visualEditor.pickElement",
    "onCommand:eri.visualEditor.applyToSource",
    "onView:eri.review",
    "onCommand:eri.review.local",
    "onCommand:eri.review.staged",
    "onCommand:eri.review.range",
    "onCommand:eri.review.pr",
    "onCommand:eri.review.patch",
    "onCommand:eri.review.openReport",
    "onCommand:eri.account.signIn",
    "onCommand:eri.account.signOut",
