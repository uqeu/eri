        { "command": "eri.terminals.saveLayout",   "when": "view == eri.terminals", "group": "navigation@3" },
        { "command": "eri.terminals.openRecipe",   "when": "view == eri.terminals", "group": "navigation@4" },
        { "command": "eri.terminals.findCommand",  "when": "view == eri.terminals", "group": "navigation@5" },
        { "command": "eri.review.local",       "when": "view == eri.review", "group": "navigation@1" },
        { "command": "eri.review.pr",          "when": "view == eri.review", "group": "navigation@2" },
        { "command": "eri.review.openReport",  "when": "view == eri.review", "group": "navigation@3" },
        { "command": "eri.review.clear",       "when": "view == eri.review", "group": "navigation@4" }
      ],
      "view/item/context": [
        { "command": "eri.mcp.viewTools",  "when": "view == eri.mcp && viewItem =~ /^eri\\.mcp\\.server\\./", "group": "inline@1" },
        { "command": "eri.mcp.restart",    "when": "view == eri.mcp && viewItem =~ /^eri\\.mcp\\.server\\./", "group": "inline@2" },
        { "command": "eri.mcp.openConfig", "when": "view == eri.mcp && viewItem =~ /^eri\\.mcp\\.server\\./", "group": "navigation@1" },
        { "command": "eri.checkpoints.restore", "when": "view == eri.checkpoints && viewItem == eri.checkpoint", "group": "1_restore@1" },
        { "command": "eri.checkpoints.diff",    "when": "view == eri.checkpoints && viewItem == eri.checkpoint", "group": "2_inspect@1" },
        { "command": "eri.checkpoints.copySha", "when": "view == eri.checkpoints && viewItem == eri.checkpoint", "group": "2_inspect@2" },
        { "command": "eri.checkpoints.delete",  "when": "view == eri.checkpoints && viewItem == eri.checkpoint", "group": "9_destructive@1" },
        { "command": "eri.checkpoints.openFile", "when": "view == eri.checkpoints && viewItem == eri.checkpoint.file", "group": "1_open@1" },
        { "command": "eri.checkpoints.diffFile", "when": "view == eri.checkpoints && viewItem == eri.checkpoint.file", "group": "1_open@2" },
        { "command": "eri.apply.showDiff",    "when": "view == eri.pendingEdits && viewItem =~ /^eri\\.apply\\.block/", "group": "inline@1" },
        { "command": "eri.apply.acceptBlock", "when": "view == eri.pendingEdits && viewItem == eri.apply.block.pending", "group": "inline@2" },
        { "command": "eri.apply.rejectBlock", "when": "view == eri.pendingEdits && viewItem == eri.apply.block.pending", "group": "inline@3" },
        { "command": "eri.apply.acceptBlock", "when": "view == eri.pendingEdits && viewItem == eri.apply.block.rejected", "group": "inline@2" },
        { "command": "eri.apply.rejectBlock", "when": "view == eri.pendingEdits && viewItem == eri.apply.block.accepted", "group": "inline@2" },
        { "command": "eri.apply.resetBlock",  "when": "view == eri.pendingEdits && viewItem =~ /^eri\\.apply\\.block\\.(accepted|rejected)$/", "group": "inline@3" },
        { "command": "eri.terminals.renameGroup",  "when": "view == eri.terminals && viewItem =~ /^eri\\.terminal\\.group/",     "group": "1_modify@1" },
        { "command": "eri.terminals.setGroupIcon", "when": "view == eri.terminals && viewItem =~ /^eri\\.terminal\\.group/",     "group": "1_modify@2" },
        { "command": "eri.terminals.removeGroup",  "when": "view == eri.terminals && viewItem =~ /^eri\\.terminal\\.group/",     "group": "9_destructive@1" },
        { "command": "eri.terminals.rename",       "when": "view == eri.terminals && viewItem =~ /^eri\\.terminal(\\.locked)?$/", "group": "1_modify@1" },
        { "command": "eri.terminals.toggleLock",   "when": "view == eri.terminals && viewItem =~ /^eri\\.terminal(\\.locked)?$/", "group": "1_modify@2" },
        { "command": "eri.terminals.duplicate",    "when": "view == eri.terminals && viewItem =~ /^eri\\.terminal(\\.locked)?$/", "group": "2_action@1" },
        { "command": "eri.terminals.moveToGroup",  "when": "view == eri.terminals && viewItem =~ /^eri\\.terminal(\\.locked)?$/", "group": "2_action@2" },
        { "command": "eri.terminals.kill",         "when": "view == eri.terminals && viewItem =~ /^eri\\.terminal(\\.locked)?$/", "group": "9_destructive@1" },
        { "command": "eri.terminals.restoreLayout", "when": "view == eri.terminals && viewItem == eri.terminal.layout", "group": "1_action@1" },
        { "command": "eri.graph.openNodeJson", "when": "view == eri.graph && viewItem == eri.graph.node", "group": "1_open@1" },
        { "command": "eri.graph.tagNode",      "when": "view == eri.graph && viewItem == eri.graph.node", "group": "2_modify@1" },
        { "command": "eri.graph.linkRelated",  "when": "view == eri.graph && viewItem == eri.graph.node", "group": "2_modify@2" },
        { "command": "eri.terminals.deleteLayout",  "when": "view == eri.terminals && viewItem == eri.terminal.layout", "group": "9_destructive@1" },
        { "command": "eri.review.applyFix",  "when": "view == eri.review && viewItem == eri.review.finding.fixable", "group": "inline@1" },
        { "command": "eri.review.dismiss",   "when": "view == eri.review && viewItem =~ /^eri\\.review\\.finding/",  "group": "inline@2" },
        { "command": "eri.review.openFinding", "when": "view == eri.review && viewItem =~ /^eri\\.review\\.finding/", "group": "1_open@1" },
        { "command": "eri.review.applyFix",  "when": "view == eri.review && viewItem == eri.review.finding.fixable", "group": "1_open@2" },
        { "command": "eri.review.dismiss",   "when": "view == eri.review && viewItem =~ /^eri\\.review\\.finding/",  "group": "9_destructive@1" }
      ]
    },
    "keybindings": [
      { "command": "eri.inlineEdit",       "key": "cmd+k",              "mac": "cmd+k",              "when": "editorTextFocus && !suggestWidgetVisible" },
      { "command": "eri.openChat",         "key": "cmd+l",              "mac": "cmd+l" },
      { "command": "eri.openComposer",     "key": "cmd+i",              "mac": "cmd+i" },
      { "command": "eri.openAgentLayout",  "key": "cmd+e",              "mac": "cmd+e" },
      { "command": "eri.modeMenu",         "key": "cmd+.",              "mac": "cmd+." },
      { "command": "eri.cycleModel",       "key": "cmd+/",              "mac": "cmd+/" },
      { "command": "eri.toggleMic",        "key": "cmd+shift+space",    "mac": "cmd+shift+space" },
      { "command": "eri.acceptIteration",  "key": "cmd+enter",          "mac": "cmd+enter",          "when": "eri.previewVisible" },
      { "command": "eri.rejectIteration",  "key": "cmd+backspace",      "mac": "cmd+backspace",      "when": "eri.previewVisible" },
      { "command": "eri.stopGeneration",   "key": "cmd+shift+backspace","mac": "cmd+shift+backspace","when": "eri.streaming" },
      { "command": "eri.tab.acceptWord",   "key": "cmd+right",          "mac": "cmd+right",          "when": "inlineSuggestionVisible && editorTextFocus" },
      { "command": "eri.tab.acceptLine",   "key": "cmd+down",           "mac": "cmd+down",           "when": "inlineSuggestionVisible && editorTextFocus" },
      { "command": "eri.mentions.openPicker", "key": "cmd+shift+2",     "mac": "cmd+shift+2" }
    ],
    "configuration": {
      "title": "eri",
      "properties": {
        "eri.coreutilsPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the eri-coreutils sidecar binary. Defaults to the bundled binary in the app's Resources/bin/ directory."
        },
        "eri.apiBaseUrl": {
          "type": "string",
          "default": "https://eri.dev",
          "description": "Base URL for the eri website API used to fetch the current user's tier and feature flags."
        },
        "eri.model": {
          "type": "string",
          "enum": ["mercury-2", "mercury-2-coder", "claude-opus-4-7", "claude-sonnet-4-6", "gpt-5", "gemini-2.5-pro"],
          "enumDescriptions": [
            "eri Engine",
            "eri Engine (coder)",
            "Claude Opus 4.7",
            "Claude Sonnet 4.6",
            "GPT-5",
            "Gemini 2.5 Pro"
          ],
          "default": "mercury-2",
          "description": "Default model for diffusion iteration"
        },
        "eri.voice.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable **voice input** (push-to-talk on `Cmd+L`). Toggle live in the Settings Hub."
        },
        "eri.voice.hotMic": {
          "type": "boolean",
          "default": false,
          "description": "Keep the mic open continuously (vs push-to-talk)"
        },
        "eri.voice.preset": {
          "type": "string",
          "enum": ["lumen", "marrow", "sable", "vesper", "kiln"],
          "default": "lumen",
          "markdownDescription": "ElevenLabs **preset voice** eri uses to speak responses. Pick one in the Settings Hub for an instant preview."
        },
        "eri.preview.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the diffusion preview beside the editor on new builds"
        },
        "eri.tab.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable eri Tab inline completions (predictive multi-line suggestions)."
        },
        "eri.tab.minPrefixLength": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Minimum number of characters before the cursor required before eri Tab requests a suggestion."
        },
        "eri.tab.modelOverride": {
          "type": "string",
          "default": "",
          "description": "Optional model identifier passed to the sidecar for eri Tab completions. Leave blank to use the default routing."
        },
        "eri.tab.model": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Identifier for the eri Tab GGUF model. Today only the bundled Qwen2.5-Coder build is wired up; the value is also used to choose the FIM prompt template."
        },
        "eri.tab.maxTokens": {
          "type": "number",
          "default": 64,
          "minimum": 1,
          "description": "Maximum tokens to generate per eri Tab completion."
        },
        "eri.mcp.configPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the MCP servers config (JSON). Leave blank to use ~/.eri/mcp.json."
        },
        "eri.mcpPresets.autoSuggest": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the **MCP starter pack** after onboarding finishes so you have working tools on first launch."
        },
        "eri.mcpPresets.includeBeta": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show **beta** MCP servers (those marked beta in the catalog, e.g. Puppeteer) in the browse view."
        },
        "eri.gaze.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable **gaze tracking** integration with the editor. Disable to stop the camera-based attention signal."
        },
        "eri.gaze.decorationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Draw a subtle accent on the line the user is currently fixated on."
        },
        "eri.gaze.contextRadius": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Number of lines around the gaze point that count as the user's working context."
        },
        "eri.gaze.sensitivity": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "Gaze tracking sensitivity (`1`–`100`). Higher values make gaze events fire more eagerly. Tune via the **Settings Hub** for a live slider."
        },
        "eri.terminals.voiceTargeting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Allow voice transcripts to drive terminal actions (focus, send, kill, spawn layouts)."
        },
        "eri.terminals.gazeTargeting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use gaze to resolve pronouns like \"kill it\" to whichever terminal you're currently looking at."
        },
        "eri.terminals.killSoftCtrlC": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When voice says \"kill\", send `Ctrl+C` to the foreground process instead of disposing the terminal."
        },
        "eri.terminals.gazeDwellMs": {
          "type": "number",
          "default": 800,
          "minimum": 200,
          "maximum": 3000,
          "markdownDescription": "Milliseconds of fixation required before a terminal is treated as gaze-attended."
        },
        "eri.model.default": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Default model identifier used by eri when no explicit model is selected. Use `auto` to defer to **auto routing**."
        },
        "eri.model.autoRouting": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When `true`, eri picks the cheapest capable model for each turn instead of always using `#eri.model.default#`."
        },
        "eri.index.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Build and maintain the local workspace **index** used for retrieval-augmented prompts. Disabling stops new indexing but keeps the existing database."
        },
        "eri.privacy.telemetry": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Send anonymous, aggregate **telemetry** (no code, no prompts) to help improve eri. Off by default."
        },
        "eri.privacy.audit": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Write every sidecar JSON-RPC dispatch to a **local audit log** at `~/.eri/audit.log` (or `<workspace>/.eri/audit.log`). Records method names, durations, and parameter *shapes* only — never prompts, model outputs, file contents, or secrets. Off by default."
        },
        "eri.privacy.crashReporting": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Send sanitized **crash reports** to eri via Sentry. Local crash logs at `~/.eri/crash.log` are always written regardless of this setting. Off by default — local-first."
        },
        "eri.privacy.crashReportingDsn": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional override **Sentry DSN** for crash reports. Leave blank to use the default eri DSN. Has no effect unless `#eri.privacy.crashReporting#` is on."
        },
        "eri.appearance.theme": {
          "type": "string",
          "enum": ["auto", "light", "dark"],
          "default": "auto",
          "markdownDescription": "Color theme used by eri webviews. `auto` follows the editor theme."
        },
        "eri.appearance.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 10,
          "maximum": 20,
          "markdownDescription": "Font size in pixels for eri webviews. Range: `10`–`20`."
        },
        "eri.visualEditor.url": {
          "type": "string",
          "default": "http://localhost:5173",
          "markdownDescription": "Default **dev server URL** loaded into the Visual Editor iframe. Pick a different URL at runtime with `eri: Visual Editor - Set Dev Server URL`."
        },
        "eri.visualEditor.voiceEdit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Allow voice transcripts to **drive style edits** in the Visual Editor (e.g. \"make this red\", \"add a shadow\")."
        },
        "eri.visualEditor.gazePick": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use **gaze dwell** to auto-pick the element you're looking at in the Visual Editor preview."
        },
        "eri.visualEditor.gazeDwellMs": {
          "type": "number",
          "default": 800,
          "minimum": 200,
          "maximum": 5000,
          "markdownDescription": "Number of milliseconds of stable gaze before the Visual Editor auto-picks the element under your gaze."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.116.0",
    "typescript": "^5.4.0"
  }
}
