{
  "name": "eri-ai-panel",
  "displayName": "eri",
  "description": "Voice-driven diffusion AI panel for eri",
  "version": "0.1.0",
  "publisher": "eri",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.116.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:eri.crashes",
    "onCommand:eri.crash.refresh",
    "onCommand:eri.crash.openLog",
    "onCommand:eri.crash.openSidecarLog",
    "onCommand:eri.crash.clear",
    "onCommand:eri.crash.copyLast",
    "onView:eri.panel",
